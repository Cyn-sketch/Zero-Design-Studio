    "hero": {
      "eyebrow": "About us",
      "title": "Zero Design Studio is a multidisciplinary experience design company",
      "intro": "We are a leading multidimensional experience design agency, transforming concepts into extraordinary realities through innovative content creation, cutting-edge production and bold storytelling worldwide. Our expertise lies in crafting experiences that go beyond traditional boundaries: immersive interactions that engage audiences, entertain with creativity and inspire growth, evolving ideas into impactful, fresh perspectives."
    },
    "vision": {
      "eyebrow": "Vision & mission",
      "statement": "To push the boundaries of experience design and transform how the world engages with stories.",
      "body": "Every brief starts with the room: who’s in it, what they should feel, and the one moment they’ll talk about afterwards. We design the content, the space and the show around that moment, then build it on LED, holograms, anamorphic screens and projection."
    },
